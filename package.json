{
  "name": "delivery-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @delivery/web",
    "dev:admin": "npm run dev -w @delivery/admin",
    "dev:mobile": "npm run start -w @delivery/mobile",
    "dev:customer": "npm run start -w @delivery/customer",
    "build:web": "npm run build -w @delivery/web",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.3.3",
    "typescript": "^5.5.0"
  }
}
